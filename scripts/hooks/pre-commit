#!/usr/bin/env bash
# Pre-commit hook: chain repo checks.
# Installed by `make install-hooks`.
#
# Checks (in order):
#   1. PII scan on staged files
#   2. Block edits to upstream-tracked skills/<name>/ (override with SKIP_UPSTREAM_GUARD=1)
#   3. Skills index: every skill has summary: and group:, and README § Skills is
#      current. Runs only when the commit touches what the index is built from, so
#      a design/ or diary commit is never blocked by it.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

"$REPO_ROOT/scripts/check-pii.sh" --staged
"$REPO_ROOT/scripts/check-upstream-edits.sh"

if git diff --cached --name-only | grep -qE '^(skills/|README\.md$|scripts/skills-index)'; then
    python3 "$REPO_ROOT/scripts/skills-index.py" check
fi
